{
  "name": "@zero-to-one/system-design",
  "version": "1.0.0",
  "private": true,
  "description": "Capacity calculators, rate-limiter and cache proofs, discrete-event queueing simulator, payment ledger invariants, and SRE SLO burn-rate tests for Zero-to-One System Design",
  "type": "module",
  "scripts": {
    "test": "node --experimental-strip-types --test \"examples/0[1-79]-*.test.ts\" \"examples/[1-9][0-9]-*.test.ts\"",
    "test:integration": "node --experimental-strip-types --test \"examples/08-*.test.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "oxlint -c ../../.oxlintrc.json .",
    "fmt": "oxfmt -c ../../.oxfmtrc.json .",
    "fmt:check": "oxfmt -c ../../.oxfmtrc.json --check ."
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "fast-check": "4.10.3",
    "oxfmt": "0.76.0",
    "oxlint": "1.91.0",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=26"
  }
}
