{
  "name": "zero-to-one",
  "private": true,
  "description": "Repository-wide tooling only (formatting, linting, Markdown gates). Track dependencies stay in each track's own package.json.",
  "type": "module",
  "scripts": {
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "lint": "oxlint .",
    "lint:md": "npm run lint:wrap && npm run lint:tables && npm run lint:links && npm run lint:mermaid",
    "check": "npm run fmt:check && npm run lint && npm run lint:md",
    "lint:wrap": "node tools/wrap-check/check.mjs .",
    "lint:tables": "node tools/table-check/check.mjs .",
    "lint:links": "LINK_CHECK_PENDING=technologies/nodejs,technologies/sqlite,technologies/redis,technologies/elasticsearch,technologies/observability,technologies/gitlab-ci,technologies/containers,technologies/kubernetes,technologies/argocd,technologies/terraform,technologies/aws,technologies/gcp,technologies/azure,technologies/cloudflare,architecture/cloud-foundations,architecture/system-design node tools/link-check/check.mjs .",
    "lint:mermaid": "node tools/mermaid-check/check.mjs ."
  },
  "devDependencies": {
    "oxfmt": "0.76.0",
    "oxlint": "1.91.0"
  }
}
