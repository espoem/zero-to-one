{
  "name": "zero-to-one-redis",
  "version": "8.10.3",
  "private": true,
  "description": "Executable proofs for the zero-to-one Redis Open Source 8.x track (with Valkey 9.x deltas)",
  "type": "module",
  "scripts": {
    "test": "node --test --test-reporter=spec \"examples/ts/*.test.ts\"",
    "test:integration": "node --test --test-concurrency=1 --test-reporter=spec \"examples/ts/integration/*.test.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "oxlint -c ../../.oxlintrc.json .",
    "fmt": "oxfmt -c ../../.oxfmtrc.json .",
    "fmt:check": "oxfmt -c ../../.oxfmtrc.json --check ."
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "fast-check": "4.10.2",
    "fengari": "0.1.5",
    "oxfmt": "0.76.0",
    "oxlint": "1.91.0",
    "redis": "6.3.1",
    "testcontainers": "12.2.1",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=26"
  }
}
