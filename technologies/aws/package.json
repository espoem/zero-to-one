{
  "name": "@zero-to-one/aws",
  "version": "1.0.0",
  "private": true,
  "description": "Executable proofs, IAM policy evaluation models, and architecture simulations for the Zero-to-One AWS track",
  "type": "module",
  "scripts": {
    "test": "node --experimental-strip-types --test \"examples/**/*.test.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "oxlint -c ../../.oxlintrc.json .",
    "fmt": "oxfmt -c ../../.oxfmtrc.json .",
    "fmt:check": "oxfmt -c ../../.oxfmtrc.json --check ."
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "fast-check": "4.10.2",
    "oxfmt": "0.76.0",
    "oxlint": "1.91.0",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=22"
  }
}
