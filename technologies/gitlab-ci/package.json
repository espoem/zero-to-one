{
  "name": "zero-to-one-gitlab-ci",
  "version": "1.0.0",
  "private": true,
  "description": "Executable proofs and models for the zero-to-one GitLab CI/CD track",
  "type": "module",
  "scripts": {
    "test": "node --test --test-reporter=spec \"examples/ts/*.test.ts\"",
    "test:integration": "node --test --test-concurrency=1 --test-reporter=spec \"examples/ts/integration/*.test.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "oxlint -c ../../.oxlintrc.json .",
    "fmt": "oxfmt -c ../../.oxfmtrc.json .",
    "fmt:check": "oxfmt -c ../../.oxfmtrc.json --check ."
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "fast-check": "4.10.2",
    "oxfmt": "0.76.0",
    "oxlint": "1.91.0",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=26"
  }
}
