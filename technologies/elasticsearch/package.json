{
  "name": "zero-to-one-elasticsearch",
  "version": "1.0.0",
  "private": true,
  "description": "Executable proofs for the zero-to-one Elasticsearch 9.x / Lucene 10 track",
  "type": "module",
  "scripts": {
    "test": "node --import ./examples/setup.ts --test --test-reporter=spec \"examples/*.test.ts\"",
    "test:integration": "node --test --test-reporter=spec --test-concurrency=1 \"examples/integration/*.itest.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "oxlint -c ../../.oxlintrc.json .",
    "fmt": "oxfmt -c ../../.oxfmtrc.json .",
    "fmt:check": "oxfmt -c ../../.oxfmtrc.json --check ."
  },
  "dependencies": {
    "@elastic/elasticsearch": "9.5.1"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "fast-check": "4.10.2",
    "oxfmt": "0.76.0",
    "oxlint": "1.91.0",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=26"
  }
}
