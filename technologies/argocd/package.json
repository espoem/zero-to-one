{
  "name": "@zero-to-one/argocd",
  "version": "1.0.0",
  "private": true,
  "description": "Executable proofs and models for the zero-to-one Argo CD track",
  "type": "module",
  "scripts": {
    "test": "node --import tsx --test 'examples/ts/*.test.ts'",
    "test:integration": "node --import tsx --test 'examples/ts/integration/*.test.ts'",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "oxlint -c ../../.oxlintrc.json .",
    "fmt": "oxfmt -c ../../.oxfmtrc.json .",
    "fmt:check": "oxfmt -c ../../.oxfmtrc.json --check ."
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "fast-check": "4.10.2",
    "oxfmt": "0.76.0",
    "oxlint": "1.91.0",
    "tsx": "^4.19.0",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=26"
  }
}
