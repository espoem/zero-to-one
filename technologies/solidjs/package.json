{
  "name": "zero-to-one-solidjs",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "test": "vitest run",
    "test:client": "vitest run --project client",
    "test:server": "vitest run --project server",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json",
    "versions": "node scripts/print-versions.mjs"
  },
  "dependencies": {
    "@solidjs/signals": "2.0.0-rc.19",
    "@solidjs/web": "2.0.0-rc.19",
    "solid-js": "2.0.0-rc.19"
  },
  "devDependencies": {
    "@solidjs/compiler": "2.0.0-rc.19",
    "@solidjs/testing-library": "1.0.0-rc.2",
    "@solidjs/vite-plugin": "3.0.0-next.52",
    "@types/node": "26.6.6",
    "jsdom": "30.1.3",
    "solid-js-1": "npm:solid-js@1.9.17",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
