{
  "name": "@zero-to-one/azure",
  "version": "1.0.0",
  "private": true,
  "description": "Executable proofs, Azure RBAC/Policy/networking models, Cosmos DB and Service Bus simulators for the Zero-to-One Azure track",
  "type": "module",
  "scripts": {
    "test": "node --experimental-strip-types --test \"examples/[0-8][0-9]-*.test.ts\"",
    "test:integration": "node --experimental-strip-types --test \"examples/09-*.test.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "oxlint -c ../../.oxlintrc.json .",
    "fmt": "oxfmt -c ../../.oxfmtrc.json .",
    "fmt:check": "oxfmt -c ../../.oxfmtrc.json --check ."
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "fast-check": "4.10.3",
    "oxfmt": "0.76.0",
    "oxlint": "1.91.0",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=26"
  }
}
