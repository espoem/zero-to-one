{
  "name": "zero-to-one-nodejs",
  "version": "1.0.0",
  "private": true,
  "description": "Executable proofs for the zero-to-one Node.js 26 LTS runtime track",
  "type": "module",
  "scripts": {
    "test": "node --test --test-timeout=60000 --test-reporter=spec \"examples/**/*.test.ts\"",
    "test:integration": "node --test --test-timeout=120000 --test-reporter=spec \"examples/integration/*.itest.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "oxlint -c ../../.oxlintrc.json .",
    "fmt": "oxfmt -c ../../.oxfmtrc.json .",
    "fmt:check": "oxfmt -c ../../.oxfmtrc.json --check ."
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "fast-check": "4.10.2",
    "fastify": "5.12.8",
    "oxfmt": "0.76.0",
    "oxlint": "1.91.0",
    "typescript": "7.0.2",
    "undici": "8.12.3"
  },
  "engines": {
    "node": ">=26"
  }
}
