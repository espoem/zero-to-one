{
  "name": "zero-to-one-dsa",
  "version": "1.0.0",
  "private": true,
  "description": "Executable proofs, algorithms, and property-based test suites for Data Structures & Algorithms",
  "type": "module",
  "scripts": {
    "test": "node --test \"examples/**/*.test.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "oxlint -c ../../.oxlintrc.json .",
    "fmt": "oxfmt -c ../../.oxfmtrc.json .",
    "fmt:check": "oxfmt -c ../../.oxfmtrc.json --check ."
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "fast-check": "^4.5.3",
    "oxfmt": "0.76.0",
    "oxlint": "1.91.0",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=26"
  }
}
