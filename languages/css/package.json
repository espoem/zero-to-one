{
  "name": "zero-to-one-css",
  "version": "1.0.0",
  "private": true,
  "description": "CSS and modern web platform curriculum: 14 modules, browser computed-style tests, layout verification, and senior technical interview question bank",
  "type": "module",
  "scripts": {
    "test": "node --test --test-concurrency=4 \"examples/**/*.test.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "oxlint -c ../../.oxlintrc.json .",
    "fmt": "oxfmt -c ../../.oxfmtrc.json .",
    "fmt:check": "oxfmt -c ../../.oxfmtrc.json --check ."
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "fast-check": "^4.5.3",
    "lightningcss": "^1.29.1",
    "oxfmt": "0.76.0",
    "oxlint": "1.91.0",
    "playwright": "1.64.1",
    "typescript": "^7.0.2"
  }
}
