{
  // Type tests for React 19 typing (@types/react 19.3). Checked by `npm run typecheck`
  // and by ../ui-typing.test.ts. Nothing here executes: JSX cannot run under Node type stripping.
  "compilerOptions": {
    "target": "esnext",
    "module": "preserve",
    "jsx": "react-jsx",
    "lib": ["esnext", "dom"],
    "types": [],
    "noEmit": true,
    "verbatimModuleSyntax": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true
  },
  "include": ["./**/*.ts", "./**/*.tsx"]
}
