{
  "name": "zero-to-one-ts-strata-fp-web",
  "version": "1.0.0",
  "private": true,
  "description": "Interactive SolidJS 2.x learning page comparing strict ES2024 and ES6 functional programming implementations",
  "type": "module",
  "imports": {
    "#strata/es2024": "../lib/es2024/index.ts",
    "#strata/es2024/*": "../lib/es2024/*.ts",
    "#strata/es6": "../lib/es6/index.ts",
    "#strata/es6/*": "../lib/es6/*.ts"
  },
  "scripts": {
    "dev": "vite --port 4174",
    "build": "vite build",
    "preview": "vite preview --port 4174",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "lint": "oxlint -c ../../../../.oxlintrc.json .",
    "fmt": "oxfmt -c ../../../../.oxfmtrc.json .",
    "fmt:check": "oxfmt -c ../../../../.oxfmtrc.json --check ."
  },
  "dependencies": {
    "@solid-primitives/clipboard": "2.0.0",
    "@solid-primitives/media": "4.0.0",
    "@solid-primitives/storage": "5.0.0",
    "@solidjs/signals": "2.0.3",
    "@solidjs/web": "2.0.3",
    "@tanstack/table-core": "9.3.1",
    "solid-js": "2.0.3"
  },
  "devDependencies": {
    "@solidjs/compiler": "2.0.2",
    "@solidjs/testing-library": "1.0.0-rc.2",
    "@solidjs/vite-plugin": "3.0.1",
    "@types/node": "26.6.6",
    "jsdom": "30.1.3",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  },
  "engines": {
    "node": ">=26"
  }
}
