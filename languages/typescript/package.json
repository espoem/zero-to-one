{
  "name": "zero-to-one-typescript",
  "version": "3.0.0",
  "private": true,
  "description": "zero-to-one TypeScript track: runnable examples, type tests and compiler-fixture tests for TypeScript 7",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "typecheck": "tsc -p . && tsc -p examples/12-typing-ui-frameworks/react && tsc -p examples/12-typing-ui-frameworks/solid",
    "test": "node --test \"examples/**/*.test.ts\"",
    "test:module": "node --test"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "expect-type": "1.4.0",
    "publint": "0.3.25",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@solidjs/web": "2.0.0-rc.19",
    "solid-js": "2.0.0-rc.19",
    "zod": "4.6.7"
  }
}
