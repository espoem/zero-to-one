{
  "name": "zero-to-one-javascript",
  "version": "1.0.0",
  "private": true,
  "description": "Executable proofs for the zero-to-one JavaScript (ECMAScript 2026) track",
  "type": "module",
  "scripts": {
    "test": "node --test --test-reporter=spec \"examples/**/*.test.{js,mjs,ts}\" \"exercises/**/*.test.mjs\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "oxlint -c ../../.oxlintrc.json .",
    "fmt": "oxfmt -c ../../.oxfmtrc.json .",
    "fmt:check": "oxfmt -c ../../.oxfmtrc.json --check .",
    "exercises": "node --test \"exercises/**/*.test.mjs\""
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "esbuild": "0.28.2",
    "fast-check": "4.10.2",
    "oxfmt": "0.76.0",
    "oxlint": "1.91.0",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=26"
  }
}
